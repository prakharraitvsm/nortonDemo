        "3806ae6e-999f-4fa9-9a14-4607f3273421": {
          "type": "question",
          "settings": {
            "title": "What if my item arrives faulty or damaged?",
            "content": "<p>In the unlikely event that you receive a faulty or damaged item, please contact our customer service team at <a href=\"mailto:clothing@nortonmotorcycles.com\">clothing@nortonmotorcycles.com</a> between 9am and 5pm Monday to Friday and we will assist you.</p>"
