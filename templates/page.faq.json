        "bc0b8034-9ac7-414b-b5f9-d7dc46d8a292": {
          "type": "question",
          "settings": {
            "title": "How do I return or exchange an item?",
            "content": "<p>Please refer to our <a href=\"https://shop.nortonmotorcycles.com/policies/refund-policy\" title=\"https://shop.nortonmotorcycles.com/policies/refund-policy\"><span style=\"text-decoration:underline\">returns policy</span></a>. </p><p>You can place a return <a href=\"https://account.nortonmotorcycles.com/\" title=\"https://account.nortonmotorcycles.com/\"><span style=\"text-decoration:underline\">here</span></a>.</p>"
