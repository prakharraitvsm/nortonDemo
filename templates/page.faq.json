        },
        "4913bed9-3a56-475f-b73c-d1544649a6f5": {
          "type": "question",
          "settings": {
            "title": "Can I cancel an order?",
            "content": "<p>If you change your mind about your order, you have up to an hour to cancel it. To do so, please email <a href=\"mailto:clothing@nortonmotorcycles.com\" title=\"mailto:clothing@nortonmotorcycles.com\">clothing@nortonmotorcycles.com</a> with your name and order number you wish to cancel.</p>"
          }
