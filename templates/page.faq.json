    "faq-second": {
      "type": "section-accordion-group",
      "blocks": {
        "heading-0": {
          "type": "heading",
          "settings": {
            "title": "MOTORCYCLES - FREQUENTLY ASKED QUESTIONS"
          }
        },
        "question-1": {
          "type": "question",
          "settings": {
            "title": "How long will it take for my Norton to be delivered?",
            "content": "<p>We build every bike made to order. Our Norton agents willkeep you well updated on the progress of your order. We’ll also discuss yourpreferred delivery / handover method and timing to suit your requirements.</p>"
          }
        },
        "question-2": {
          "type": "question",
          "settings": {
            "title": "Is home delivery available?",
            "content": "<p>Yes, home delivery is available (but certain restrictions may apply). Please discuss your delivery requirements with your Norton agent. We can also offer a handover at Bike Shed and Norton HQ.</p>"
          }
        },
        "question-3": {
          "type": "question",
          "settings": {
            "title": "I live outside of the UK. Can I place an order online?",
            "content": "<p>At this time we are only able to take orders from residents of the United Kingdom.</p>"
          }
        },
        "c19eec5d-cb9b-4e0d-8110-7b3e4276523d": {
          "type": "question",
          "settings": {
            "title": "How do you use my personal information?",
            "content": "<p>Norton Motocrycles take your privacy seriously. We will only use your personal information to provide the products and services you have requested from us or to administer your account. We may need to share your details with third parties in order to provide our services to you.<br/><br/>Our full Privacy Policy is published on our UK website and is also available on request.</p>"
          }
        },
        "847bb379-df1c-49b7-828f-7081a88d8238": {
          "type": "question",
          "settings": {
            "title": "Who do I contact to discuss my order?",
            "content": "<p>You can contact us by telephoning our sales department on 0121 565 4411 or by email at sales@nortonmotorcycles.com, quoting your order number.</p>"
          }
        },
        "f7bedb1b-0f3a-435f-8329-5958c3af6ebb": {
          "type": "question",
          "settings": {
            "title": "Can I change the personal details on my order?",
            "content": "<p>Contact a Norton agent and they may be able to update these details for you, depending on where you are in the journey.<br/><br/>If you have completed certain stages, we will be unable to change your address on your order and may need to re-submit it with your new address.</p>"
          }
        },
        "c5457ea8-a49e-4e70-9a05-967e82fe44d4": {
          "type": "question",
          "settings": {
            "title": "What if I want to cancel or amend my order?",
            "content": "<p>To cancel or amend your order you must contact a Norton agent. They will discuss your options, and help you cancel or change your order where applicable.</p>"
          }
        },
        "a223848a-bd9b-457f-a727-9676e25b7ac5": {
          "type": "question",
          "settings": {
            "title": "When do I pay the balance for my order and what types of payment are available?",
            "content": "<p>Pre-sale Reservation fee<br/><br/>You can securely pay your pre-sale reservation fee in our online shop using a credit or debit card.<br/><br/>When it comes to paying the balance due for your bike, a Norton agent will contact you to let you know that the bike is ready and to arrange a bank transfer.<br/><br/>We do not currently offer an option to purchase bikes via finance through Norton, but we will be introducing this option soon.</p>"
          }
        },
        "64a2a9ba-f988-4f83-bc62-8600ca741cac": {
          "type": "question",
          "settings": {
            "title": "Can I part-exchange my current bike as part payment formy new Norton?",
            "content": "<p>We do not currently offer part exchanges, but we will be introducing this option soon.</p>"
          }
        },
        "eacfb5b1-94ce-4b11-a0e6-ad005f30f282": {
          "type": "question",
          "settings": {
            "title": "Who do I contact if I have an issue with my bike post-delivery?",
            "content": "<p>You can contact us by telephoning our customer service department on 0121 565 4411 or by email at <a href=\"mailto:sales@nortonmotorcycles.com\" title=\"mailto:sales@nortonmotorcycles.com\">sales@nortonmotorcycles.com</a>, quoting your order number.</p>"
          }
        }
